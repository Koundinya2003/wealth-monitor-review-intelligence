# AI/LLM Configuration
# OpenRouter API key for AI-powered recommendations
OPENROUTER_API_KEY=
# Alternative: OpenAI API key (used as fallback if OpenRouter is unavailable)
OPENAI_API_KEY=
# OpenRouter model to use (default: DeepSeek free model)
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Database Configuration
# SQLite database URL (default: wealth.db in current directory)
DATABASE_URL=wealth.db

# NewsAPI Configuration (optional - for real-time financial news)
# Get your API key from https://newsapi.org/
NEWSAPI_API_KEY=

# Reddit API Configuration (optional - for investment discussions)
# Get your credentials from https://www.reddit.com/prefs/apps
REDDIT_API_KEY=
REDDIT_API_SECRET=
# Reddit user agent (default: WealthCoachAI/1.0)
REDDIT_USER_AGENT=WealthCoachAI/1.0
